# Copy to .env and fill in. .env is gitignored — never commit real keys.

# console.apify.com → Settings → API & Integrations (free plan includes monthly credit)
APIFY_TOKEN=

# aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=

# Optional overrides
# GEMINI_VIDEO_MODEL=gemini-3.5-flash-lite
# GEMINI_REPAIR_MODEL=gemini-3.1-flash-lite
# GEMINI_STRATEGY_MODEL=gemini-3-flash-preview
# GEMINI_BACKUP_MODEL=gemini-3.5-flash-lite
# PACE_SECONDS=8
# CHROME_PATH=/path/to/chrome   # used to print the PDF; HTML is always written
